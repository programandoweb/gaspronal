APP_NAME=Gaspronal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gaspronal
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

JWT_SECRET=
JWT_TTL=120
JWT_REFRESH_TTL=20160

REALTIME_INTERNAL_URL=http://realtime:4100
WHATSAPP_OTP_TTL_MINUTES=5
WHATSAPP_OTP_MAX_ATTEMPTS=5

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

DEPLOYMENT_ENABLED=false
DEPLOYMENT_SCRIPT=/var/www/gaspronal.programandoweb.net/scripts/deploy.sh
DEPLOYMENT_PHP_BINARY=php
DEPLOYMENT_TIMEOUT=1800
DEPLOYMENT_USE_SUDO=false
DEPLOYMENT_SUDO_COMMAND=/usr/local/bin/gaspronal-deploy

ADMIN_NAME="Administrador Gaspronal"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Solo compatibilidad con la configuración previa. Preferir dashboard/configuracion.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_HOST=graph.facebook.com
