COMPOSE_PROJECT_NAME=gaspronal

FRONTEND_PORT=3000
BACKEND_PORT=8080
REALTIME_PORT=4100
# Orígenes web permitidos para realtime; admite varios separados por coma.
REALTIME_CORS_ORIGIN=https://gaspronal.programandoweb.net
BROWSER_SOCKET_PATH=/browser
BROWSER_TASK_TIMEOUT_MS=90000
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AGENT_SHARED_SECRET=
# Opcional: URL pública Socket.IO. Si queda vacía, el chat usa REST fallback hasta configurarla.
NEXT_PUBLIC_REALTIME_URL=
NEXT_PUBLIC_SITE_URL=https://www.gaspronal.com

DB_DATABASE=gaspronal
DB_USERNAME=gaspronal
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# Obtén el GID real con:
# stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

DEPLOYMENT_TIMEOUT=1800
