PORT=4100
AGENTS_PATH=agents
CORS_ORIGIN=https://gaspronal.programandoweb.net
# Opcional. Si se configura, REST usa Bearer token y Socket.IO usa auth.token.
AGENT_SHARED_SECRET=
BROWSER_SOCKET_PATH=/browser
BROWSER_TASK_TIMEOUT_MS=90000
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Chrome WhatsApp extension -> Gaspronal realtime.
# The extension keeps the existing Socket.IO contract:
# lm.request / lm.cancel / lm.accepted / lm.started / lm.completed / lm.error
INFERENCE_CLIENT_TOKEN=change-this-inference-token

# Direct LM Studio endpoint reachable from the Gaspronal VPS through WireGuard.
LM_STUDIO_BASE_URL=http://10.8.0.2:1234
LM_STUDIO_REQUEST_TIMEOUT_MS=120000
LM_STUDIO_MAX_BODY_BYTES=2097152
